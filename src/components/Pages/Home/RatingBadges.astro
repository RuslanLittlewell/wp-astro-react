---
import Stars from "@/components/Shared/Stars.astro";
import type { GoogleReviews } from "@/lib/wp";
import type { YandexRating } from "@/lib/yandex";
import { plural } from "@/lib/utils";

interface Props {
  google: GoogleReviews | null;
  yandex: YandexRating | null;
}

const { google, yandex } = Astro.props;

const badges = [
  google && { logo: "google", rating: google.rating, count: google.count, source: "в Google" },
  yandex && { logo: "yandex", rating: yandex.rating, count: yandex.count, source: "в Яндексе" },
].filter(Boolean) as { logo: string; rating: number; count: number; source: string }[];
---

{badges.length > 0 && (
  <div class="flex flex-wrap gap-2 md:gap-3 mt-6">
    {badges.map((badge) => (
      <a
        href="#reviews"
        class="flex items-center gap-2 md:gap-3 rounded-xl bg-white/95 hover:bg-white text-gray-800 px-2.5 md:px-3 py-2 shadow-lg transition-colors"
      >
        {badge.logo === "google" ? (
          <svg viewBox="0 0 48 48" class="size-6 md:size-7 shrink-0" role="img" aria-label="Google">
            <path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20 20-8.955 20-20c0-1.341-.138-2.65-.389-3.917z" />
            <path fill="#FF3D00" d="M6.306 14.691l6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 16.318 4 9.656 8.337 6.306 14.691z" />
            <path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238A11.91 11.91 0 0 1 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z" />
            <path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303a12.04 12.04 0 0 1-4.087 5.571l.003-.002 6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917z" />
          </svg>
        ) : (
          <svg viewBox="0 0 48 48" class="size-6 md:size-7 shrink-0" role="img" aria-label="Яндекс">
            <circle cx="24" cy="24" r="24" fill="#FC3F1D" />
            <text x="24" y="33" text-anchor="middle" fill="#fff" font-family="Arial, sans-serif" font-size="27" font-weight="700">Я</text>
          </svg>
        )}
        <div class="leading-tight">
          <div class="flex items-center gap-1.5">
            <span class="font-bold md:text-lg">{badge.rating.toFixed(1).replace(".", ",")}</span>
            <Stars value={badge.rating} size="size-3 md:size-3.5" class="gap-0.5" />
          </div>
          {badge.count > 0 && (
            <div class="text-xs text-gray-500">
              {`${badge.count} ${plural(badge.count, ["оценка", "оценки", "оценок"])}`}
              <span class="hidden md:inline">{` ${badge.source}`}</span>
            </div>
          )}
        </div>
      </a>
    ))}
  </div>
)}
