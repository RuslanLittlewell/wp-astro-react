---
import { cn } from "@/lib/utils";

interface Props {
  value: number;
  size?: string;
  class?: string;
}

const { value, size = "size-4", class: className = "" } = Astro.props;
---

<div class={cn("flex gap-1", className)} role="img" aria-label={`Рейтинг ${value} из 5`}>
  {Array.from({ length: 5 }, (_, i) => (
    <svg viewBox="0 0 24 24" class={cn(size, i < Math.round(value) ? "fill-amber-400" : "fill-gray-200")} aria-hidden="true">
      <path d="M12 2.5l2.94 5.96 6.56.95-4.75 4.63 1.12 6.54L12 17.5l-5.87 3.08 1.12-6.54L2.5 9.41l6.56-.95z" />
    </svg>
  ))}
</div>
